# ============================================================
# 生产环境配置模板（Windows Server / Linux 均可）
# 用法：cp .env.production.example .env  然后逐项修改
# 安全要求：以下敏感值在生产环境必须更换，严禁沿用本地值
# ============================================================

APP_NAME=工单系统
# 生产必须 = production；debug 必须 = false（防堆栈/环境变量泄露）
APP_ENV=production
APP_DEBUG=false
# 生产域名，务必与 nginx 配置一致
APP_URL=https://your-domain.example.com
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en

# 生产必须重新生成：php artisan key:generate
APP_KEY=

# 日志级别生产用 warning 起步
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ---------------- 数据库 ----------------
# Windows 用 127.0.0.1 + 实际端口；Linux 用 127.0.0.1 或内网地址
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_ticket
DB_USERNAME=your_db_user
DB_PASSWORD=your_strong_db_password

# ---------------- 会话/缓存/队列 ----------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true      # https 下开启，防会话被中间人窃取
CACHE_STORE=database
QUEUE_CONNECTION=database       # 若启用邮件/通知入队，需跑 queue:work

# ---------------- 邮件（真实发送，禁止 log） ----------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.your-mail-provider.com
MAIL_PORT=465
MAIL_USERNAME=your-mail-username
MAIL_PASSWORD=your-mail-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@your-domain.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------- 附件/存储 ----------------
# 附件存私有盘 local，nginx 无需暴露 /storage（security 强制项，勿改）
FILESYSTEM_DISK=local

# ---------------- 短信通道（生产切真实驱动） ----------------
# 也可在 系统设置 → 短信通道 页面填写（数据库优先于 .env）
# SMS_DRIVER=aliyun            # 或 tencent
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_TEMPLATE_ID=
# SMS_ALLOW_DEMO_CODE=false    # 生产必须关闭万能验证码 123456

# ---------------- 微信扫码登录（生产填真实开放平台参数） ----------------
# WECHAT_APPID=
# WECHAT_SECRET=
# WECHAT_REDIRECT_URL=https://your-domain.example.com/login/wechat/callback

# ---------------- 实时服务（GatewayWorker） ----------------
# WS_SECRET 生产必须更换为一串随机长字符串（与 websocket/start.php 保持一致）
WS_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
WS_GATEWAY_LISTEN=0.0.0.0:6001

# ---------------- 安全：管理后台前缀 ----------------
# 生产建议换掉默认 console，避免被扫描工具枚举
# 改完后访问地址变为 https://your-domain.example.com/<新前缀>/
ADMIN_URL=console

# ---------------- Vite / 前端 ----------------
VITE_APP_NAME="${APP_NAME}"
